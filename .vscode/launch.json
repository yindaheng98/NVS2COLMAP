{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "point_odyssey: sample cameras",
            "type": "debugpy",
            "request": "launch",
            "module": "nvs2colmap.blender.sample_cameras",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "--output",
                "${workspaceFolder}/data/point_odyssey/robot",
                "--n-cameras",
                "12",
                "--height",
                "1080",
                "--width",
                "1920",
                "--focal",
                "640",
                "--radius",
                "32",
                "40",
                "--cap-angle",
                "20",
                "70",
                "--spacing",
                "27.5",
                "45",
                "--blend",
                "${workspaceFolder}/data/point_odyssey/data/demo_scene/robot.blend",
                "--blender",
                "C:/Program Files (x86)/Steam/steamapps/common/Blender/blender.exe"
            ]
        },
        {
            "name": "point_odyssey: render",
            "type": "debugpy",
            "request": "launch",
            "module": "nvs2colmap.blender",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "--path",
                "${workspaceFolder}/data/point_odyssey/robot",
                "--n-frames",
                "60",
                "--start-number",
                "61",
                "--blend",
                "${workspaceFolder}/data/point_odyssey/data/demo_scene/robot.blend",
                "--blender",
                "C:/Program Files (x86)/Steam/steamapps/common/Blender/blender.exe"
            ]
        },
        {
            "name": "point_odyssey: n3dv",
            "type": "debugpy",
            "request": "launch",
            "module": "nvs2colmap.n3dv",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "--path",
                "${workspaceFolder}/data/point_odyssey/robot",
                "--ffmpeg",
                ".\\data\\ffmpeg.exe",
                "--ffprobe",
                ".\\data\\ffprobe.exe",
                "--use-colmap",
                "--colmap-executable",
                ".\\data\\colmap\\COLMAP.bat"
            ]
        }
    ]
}
